# 이 파일을 .env 로 복사한 뒤 값을 채워 사용한다. (.env 는 git에 커밋되지 않는다)
#   cp .env.example .env
#
# 아래 값은 docker-compose.yml 의 로컬 컨테이너 설정과 일치해야 한다.
USER_DATABASE_PASSWORD=password
USER_REDIS_PASSWORD=password

# 32자 이상 필수 (config 검증에서 min=32 로 강제된다). 운영 값과 다르게 설정할 것.
USER_SECRET_JWTSECRET=local-dev-only-32-characters-min
